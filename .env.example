# Copy this file to .env.local and fill values. Never commit .env.local.

# Required. Long random string. Generate: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Site address. Local: http://localhost:3000  Production: https://your-domain
BETTER_AUTH_URL=http://localhost:3000

# Database. Empty = local file database in .data/pglite (no signup needed).
# Real site (S7): ONE Neon connection string, the same in .env.local (main folder + live/) and in Vercel,
# e.g. postgresql://user:pass@host/db?sslmode=require . Migrations: npm run db:migrate (Vercel runs it in vercel-build).
DATABASE_URL=

# Email (Resend). Empty = verification/reset links print in the terminal.
RESEND_API_KEY=
EMAIL_FROM=CoreCart <onboarding@resend.dev>

# Google login. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin panel (/admin): no env setting. Create admins on the server with `npm run admin:create -- --email you@example.com --name "Your Name"`.

# Stripe TEST mode secret key (sk_test_...). Empty = saving cards disabled.
STRIPE_SECRET_KEY=

# Set 1 to allow "Add sample order" button in production builds (testing only).
ALLOW_SAMPLE_ORDERS=
